---
import "../styles/github-markdown.css";
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "49.212.143.129" } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <div class="markdown-body">
      <slot />
    </div>
  </body>
</html>
